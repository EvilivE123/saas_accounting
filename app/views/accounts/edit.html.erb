<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <h1 class="h2">Edit Account</h1>
  <div class="btn-toolbar mb-2 mb-md-0">
    <!-- Danger button to delete the account -->
    <%= button_to 'Delete Account', account_path(@account), method: :delete, data: { turbo_confirm: 'Are you sure you want to delete this account? This cannot be undone.' }, class: "btn btn-sm btn-outline-danger" %>
  </div>
</div>
<div class="card shadow-sm col-md-8">
  <div class="card-body">
    <%= render 'form', account: @account %>
  </div>
</div>
